# Copy to .env only when it does not exist. Never commit real credentials.
ENVIRONMENT=development
LLM_PLANNER_PROVIDER=openai
# Installed shared wheel default; select a model available in your account.
LLM_PLANNER_MODEL=gpt-6-sol
LLM_PLANNER_REASONING_EFFORT=medium
LLM_PLANNER_VERBOSITY=medium
LLM_PLANNER_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_SECONDS=30
LLM_CALL_BUDGET_SECONDS=45
LLM_MAX_ATTEMPTS=3
OPENAI_API_KEY=
# For Gemini, change provider/model and configure its key instead.
GEMINI_API_KEY=
# Required for web search/extraction in the live tool profile.
TAVILY_API_KEY=
# Use an existing populated database and a read-only user. No migrations/ingestion.
DATABASE_URL=postgresql+psycopg://READ_ONLY_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local metadata; full traces may contain private research data.
LLM_TRACE_MODE=metadata
